# CXO for Startups - Environment Variables
# Copy this file to .env and fill in the values

# ==============================================
# AUTHENTICATION (Phase 2)
# ==============================================

# Secret key for signing JWT session cookies (use a long random string in production)
COOKIE_SECRET=generate-a-long-random-secret-here

# Admin credentials for the dashboard
ADMIN_USERNAME=admin

# Generate hash with: node -e "const b=require('bcryptjs'); console.log(b.hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=

# ==============================================
# DATABASE - Supabase PostgreSQL (Phase 3)
# ==============================================
# Get from: https://supabase.com → project → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ==============================================
# STORAGE - Firebase Storage (Phase 4)
# ==============================================
# Your Firebase project Storage bucket (e.g. your-project.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ==============================================
# AI - Google Gemini API (Phase 5)
# ==============================================
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================
# SERVER
# ==============================================
NODE_ENV=production
PORT=3000
